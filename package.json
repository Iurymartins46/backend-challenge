{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed financial service for wagering transactions",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/bootstrap.ts",
    "start": "bun src/bootstrap.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'tests/http/**/*.yml' 'scripts/**/*.ts' '*.json' '*.mjs' 'docker/**/*.yaml'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'tests/http/**/*.yml' 'scripts/**/*.ts' '*.json' '*.mjs' 'docker/**/*.yaml'",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration --max-concurrency=1",
    "test:concurrency:once": "RUN_REAL_CONCURRENCY_TESTS=true bun test tests/concurrency --max-concurrency=1",
    "test:concurrency": "bun run test:concurrency:once && bun run test:concurrency:once",
    "test:load": "bun scripts/load-test.ts",
    "lockfile:check": "bun install --frozen-lockfile --lockfile-only",
    "check": "bun run lockfile:check && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run smoke:packages && bun run security:scan",
    "docker:config": "docker compose --env-file .env -f docker/compose.yaml config --quiet",
    "docker:build": "docker compose --env-file .env -f docker/compose.yaml build api",
    "docker:build:classic": "COMPOSE_DOCKER_CLI_BUILD=0 DOCKER_BUILDKIT=0 docker compose --env-file .env -f docker/compose.yaml build api",
    "docker:up": "docker compose --env-file .env -f docker/compose.yaml up -d",
    "docker:up:build": "docker compose --env-file .env -f docker/compose.yaml up -d --build",
    "docker:start": "bun run docker:up:build && set -a && . ./.env && set +a && bun run migration:run",
    "docker:up:observability": "docker compose --env-file .env -f docker/compose.yaml -f docker/compose.observability.yaml up -d",
    "docker:up:infra": "docker compose --env-file .env -f docker/compose.yaml up -d postgres localstack localstack-init",
    "docker:down": "docker compose --env-file .env -f docker/compose.yaml down",
    "docker:ps": "docker compose --env-file .env -f docker/compose.yaml ps --all",
    "docker:logs": "docker compose --env-file .env -f docker/compose.yaml logs -f api",
    "docker:queues": "docker compose --env-file .env -f docker/compose.yaml exec -T localstack awslocal sqs list-queues",
    "migration:run": "bun ./node_modules/typeorm/cli.js migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "bun ./node_modules/typeorm/cli.js migration:revert -d src/infrastructure/database/data-source.ts",
    "migration:show": "bun ./node_modules/typeorm/cli.js migration:show -d src/infrastructure/database/data-source.ts",
    "migration:generate": "bun scripts/generate-migration.ts",
    "smoke:packages": "bun tests/smoke/packages.ts",
    "smoke:http": "bash tests/http/curl/smoke.sh",
    "security:scan": "bash scripts/security-scan.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1123.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-prometheus": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "nestjs-pino": "5.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "bun-types": "1.4.0",
    "@opentelemetry/sdk-trace-base": "2.11.0"
  }
}
