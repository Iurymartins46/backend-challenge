{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "traces",
      "title": "API traces",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"distributed-wagering-processor\" }"
        }
      ],
      "options": { "showTable": true, "showTrace": true, "spanFilters": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency from metrics",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wagering_http_request_duration_bucket{job=\"wagering-api\"}[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(wagering_http_request_duration_bucket{job=\"wagering-api\"}[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Traces received",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "sps", "decimals": 2 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["wagering", "api", "traces", "tempo"],
  "time": { "from": "now-30m", "to": "now" },
  "title": "API - Traces (Tempo)",
  "uid": "wagering-api-traces",
  "version": 1
}
