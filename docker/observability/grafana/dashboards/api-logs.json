{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "API logs",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{compose_service=\"api\"}", "queryType": "range" }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLines": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({compose_service=\"api\"}[$__interval]))",
          "legendFormat": "API logs"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "logs", "custom": { "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Errors and warnings",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_service=\"api\"} |~ \"(?i)(error|warn|fatal)\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLines": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["wagering", "api", "logs", "loki"],
  "time": { "from": "now-30m", "to": "now" },
  "title": "API - Logs (Loki)",
  "uid": "wagering-api-logs",
  "version": 1
}
