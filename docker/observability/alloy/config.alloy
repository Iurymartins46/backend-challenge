logging {
	level  = "warn"
	format = "logfmt"
}

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// Keep the Loki stream focused on the application. Prometheus, Grafana,
	// Tempo and the other observability containers are implementation details
	// and would otherwise dominate the log volume.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "api"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.process.api.receiver]
}

loki.process "api" {
	// Pino JSON logs remain searchable as raw lines when local pretty logging
	// is enabled, while JSON fields become available for structured queries.
	stage.json {
		expressions = {
			level          = "level",
			trace_id       = "traceId",
			span_id        = "spanId",
			correlation_id = "correlationId",
		}
	}

	// Keep only bounded metadata as Loki labels. Trace and correlation IDs are
	// intentionally not labels because they create an unbounded index.
	stage.labels {
		values = {
			level = "",
		}
	}

	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
