COMPOSE_PROJECT_NAME=distributed-wagering
BUN_IMAGE=oven/bun:1.4.0-alpine
POSTGRES_IMAGE=postgres:18.6-alpine
# 2026.03.0+ requires a LocalStack account and LOCALSTACK_AUTH_TOKEN.
LOCALSTACK_IMAGE=localstack/localstack:4.14.0
LOCALSTACK_AUTH_TOKEN=

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DATABASE_URL_DOCKER=postgres://wagering:wagering@postgres:5432/wagering
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_PORT=5432

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_ENDPOINT_DOCKER=http://localstack:4566
SQS_COMMAND_QUEUE_NAME=wager-transactions.fifo
SQS_COMMAND_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_COMMAND_MAX_RECEIVE_COUNT=5
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wager-command-consumer
SQS_CONSUMER_CONCURRENCY=4
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_VISIBILITY_HEARTBEAT_SECONDS=10
SQS_SHUTDOWN_TIMEOUT_MS=10000
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=0

AUTH_MODE=none
SWAGGER_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=distributed-wagering-processor
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=http://otel-collector:4318
