COMPOSE_PROJECT_NAME=distributed-wagering
BUN_IMAGE=oven/bun:1.4.0-alpine
POSTGRES_IMAGE=postgres:18.6-alpine
# 2026.03.0+ requires a LocalStack account and LOCALSTACK_AUTH_TOKEN.
LOCALSTACK_IMAGE=localstack/localstack:4.14.0
LOCALSTACK_AUTH_TOKEN=

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DATABASE_URL_DOCKER=postgres://wagering:wagering@postgres:5432/wagering
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_PORT=5432

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_ENDPOINT_DOCKER=http://localstack:4566
SQS_COMMAND_QUEUE_NAME=wager-transactions.fifo
SQS_COMMAND_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_COMMAND_MAX_RECEIVE_COUNT=5
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wager-command-consumer
SQS_CONSUMER_CONCURRENCY=4
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_VISIBILITY_HEARTBEAT_SECONDS=10
SQS_SHUTDOWN_TIMEOUT_MS=10000
SQS_OUTBOX_PUBLISHER_ENABLED=true
SQS_OUTBOX_BATCH_SIZE=10
SQS_OUTBOX_POLL_INTERVAL_MS=1000
SQS_OUTBOX_LEASE_MS=30000
SQS_OUTBOX_SHUTDOWN_TIMEOUT_MS=10000
SQS_OUTBOX_MAX_ATTEMPTS=10
SQS_OUTBOX_RETRY_BASE_DELAY_MS=1000
SQS_OUTBOX_RETRY_MAX_DELAY_MS=300000
SQS_OUTBOX_RETRY_JITTER_PERCENT=20
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_BATCH_SIZE=10
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_LEASE_MS=30000
PENDING_REFERENCE_SHUTDOWN_TIMEOUT_MS=10000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL_MS=1800000
PENDING_REFERENCE_RETRY_BASE_DELAY_MS=2000
PENDING_REFERENCE_RETRY_MAX_DELAY_MS=300000
PENDING_REFERENCE_RETRY_JITTER_PERCENT=20
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=0

AUTH_MODE=none
SWAGGER_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=distributed-wagering-processor
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=http://otel-collector:4318

# Optional Phase 12B observability overlay
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.159.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.5
TEMPO_IMAGE=grafana/tempo:2.10.8
LOKI_IMAGE=grafana/loki:3.7.7
ALLOY_IMAGE=grafana/alloy:v1.19.2
GRAFANA_IMAGE=grafana/grafana:13.1.5
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
HEALTHCHECK_TIMEOUT_MS=1000
